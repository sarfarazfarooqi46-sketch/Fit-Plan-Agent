        "!pip install -U google-genai\n",
        "\n",
        "from google import genai\n",
        "\n",
        "# Enter your Gemini API key here\n",
        "client = genai.Client(api_key=\"AQ.Ab8RN6LZkjOzK9FOQGmLaYs9_IlfGwnIc0czzbJy0GB_toF48Q\")\n",
        "\n",
        "MODEL = \"models/gemini-3.5-flash\"\n",
        "\n",
        "\n",
        "def fuuast_assistant(student_question):\n",
        "\n",
        "    university_data = {\n",
        "        \"FUUAST\": {\n",
        "            \"campuses\": {\n",
        "                \"Karachi\": {\n",
        "                    \"address\": \"Gulshan-e-Iqbal, Karachi\"\n",
        "                },\n",
        "                \"Islamabad\": {\n",
        "                    \"address\": \"Islamabad Campus\"\n",
        "                }\n",
        "            },\n",
        "\n",
        "            \"programs\": {\n",
        "                \"BSCS\": {\n",
        "                    \"Fall 2024\": {\n",
        "                        \"AI\": {\n",
        "                            \"teacher\": \"Uzma\",\n",
        "                            \"section\": \"A\"\n",
        "                        },\n",
        "\n",
        "                        \"Data Structures\": {\n",
        "                            \"teacher\": \"Dr. Muhammad Ali\",\n",
        "                            \"section\": \"A\"\n",
        "                        }\n",
        "                    }\n",
        "                }\n",
        "            }\n",
        "        }\n",
        "    }\n",
        "\n",
        "\n",
        "    prompt = f\"\"\"\n",
        "    You are an intelligent student assistance system designed\n",
        "    specifically for FUUAST University.\n",
        "\n",
        "    Your job is to provide students with useful and accurate\n",
        "    information about FUUAST by using the university data\n",
        "    provided below.\n",
        "\n",
        "    FUUAST University Information:\n",
        "    {university_data}\n",
        "\n",
        "    Please follow these guidelines carefully:\n",
        "\n",
        "    1. Always examine the provided FUUAST information first\n",
        "       before responding to a university-related question.\n",
        "\n",
        "    2. When the requested information exists in the records,\n",
        "       provide the information exactly and clearly.\n",
        "\n",
        "    3. Do not assume, invent, or make up any FUUAST-specific\n",
        "       information.\n",
        "\n",
        "    4. If a student asks about FUUAST information that is not\n",
        "       included in the records, respond with:\n",
        "       \"Sorry, this specific FUUAST information is not available\n",
        "       in my records.\"\n",
        "\n",
        "    5. Do not create information about FUUAST teachers, courses,\n",
        "       campuses, addresses, sections, programs, fees, schedules,\n",
        "       admissions, or any other university details.\n",
        "\n",
        "    6. The university name is FUUAST and it must not be changed.\n",
        "\n",
        "    7. Keep every response simple, direct, and easy for students\n",
        "       to understand.\n",
        "\n",
        "    8. General knowledge may only be used for questions that do\n",
        "       not require specific FUUAST information.\n",
        "\n",
        "    Student's Question:\n",
        "    {student_question}\n",
        "\n",
        "    Provide the most accurate response based on the instructions\n",
        "    and available FUUAST records.\n",
        "    \"\"\"\n",
        "\n",
        "\n",
        "    response = client.models.generate_content(\n",
        "        model=MODEL,\n",
        "        contents=prompt\n",
        "    )\n",
        "\n",
        "    return response.text\n",
        "\n",
        "\n",
        "print(\"FUUAST Student Support Assistant is Ready!\")\n",
        "print(\"You can ask questions about FUUAST University.\")\n",
        "print(\"Enter 'exit' whenever you want to stop.\\n\")\n",
        "\n",
        "\n",
        "while True:\n",
        "\n",
        "    student_question = input(\"Student: \")\n",
        "\n",
        "    if student_question.lower() == \"exit\":\n",
        "        print(\"Assistant closed. Goodbye!\")\n",
        "        break\n",
        "\n",
        "    try:\n",
        "\n",
        "        response = fuuast_assistant(student_question)\n",
        "\n",
        "        print(\"\\nAssistant:\")\n",
        "        print(response)\n",
        "        print()\n",
        "\n",
        "    except Exception as error:\n",
        "\n",
        "        print(\"Something went wrong:\", error)"
      ],
